PUT http://127.0.0.1:8000/api/sucursal/1
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
    "nombre": "Solo nombre"
}

### eliminar
DELETE http://127.0.0.1:8000/api/sucursal/2
Authorization: Bearer {{token}}
